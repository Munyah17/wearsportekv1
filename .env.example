# ---- Supabase (database, auth, storage) ----
# Create a free project at https://supabase.com, then run supabase/schema.sql in the SQL editor.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Paynow (server-side only, NEVER expose to the app bundle) ----
# Get these from https://forlogin.paynow.co.zw -> your integration
PAYNOW_INTEGRATION_ID=YOUR_ID
PAYNOW_INTEGRATION_KEY=YOUR_KEY
# Public base URL of this server (for Paynow callbacks)
PUBLIC_BASE_URL=http://localhost:4242
# Where the app is served (for customer return redirect)
APP_BASE_URL=http://localhost:8081
# Port for the payment server
PORT=4242

# URL of the payment server, used by the app to create payments
EXPO_PUBLIC_PAYMENT_API=http://localhost:4242
